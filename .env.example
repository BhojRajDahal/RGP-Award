DB_ROOT_PASSWORD=change-me-root-password
DB_HOST=db
DB_DOCKER_USER=nast
DB_DOCKER_PASSWORD=change-me-db-password
DB_NAME=nast
DB_POOL_SIZE=30


NODE_ENV=production
JWT_SECRET=change-me-use-at-least-32-random-characters
JWT_EXPIRES_IN=3h
REFRESH_TOKEN_EXPIRES_DAYS=14
LOG_LEVEL=info

EMAIL_SETTINGS_SECRET=change-me-use-at-least-32-random-characters #This is important

COOKIE_SECURE=true

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=


FRONTEND_PORT=3000
BACKEND_PORT=5000

# --- Email settings ---
# SMTP host/user/password/from values are managed from Admin Settings in the dashboard.
# Keep EMAIL_SETTINGS_SECRET stable; changing it will make saved SMTP passwords undecryptable.
# The SMTP_* values below are optional local-development fallback values only.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=
SMTP_FROM_NAME=


